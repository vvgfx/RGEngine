#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D litImage; // composited scene colour
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D outImage;
layout(set = 0, binding = 2) uniform sampler2D inPosition;
layout(set = 0, binding = 3) uniform sampler2D inNormal;
layout(set = 0, binding = 4) uniform sampler2D inMetalRough;

layout(set = 0, binding = 5) uniform SceneData
{
    mat4 view;
    mat4 proj;
    mat4 viewproj;
    vec4 ambientColor;
    vec4 sunlightDirection;
    vec4 sunlightColor;
    vec4 cameraPos;
    mat4 invViewproj;
    vec4 ssaoParams;
    vec4 debugParams;
}
sceneData;

layout(push_constant) uniform SSRPush
{
    vec4 params;  // x = enabled, y = max roughness, z = step count, w = thickness
    vec4 params2; // x = max distance, y = intensity, z = show reflection only
}
pc;

vec3 fresnelSchlick(float cosTheta, vec3 F0)
{
    return F0 + (1.0 - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

/// World position -> screen UV. Returns false behind the camera.
bool project(vec3 worldPos, out vec2 uv, out float clipW)
{
    vec4 clip = sceneData.viewproj * vec4(worldPos, 1.0);
    clipW = clip.w;
    if (clip.w <= 0.0)
    {
        return false;
    }
    uv = (clip.xy / clip.w) * 0.5 + 0.5;
    return true;
}

void main()
{
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outImage);
    if (texel.x >= size.x || texel.y >= size.y)
    {
        return;
    }

    vec2 uv = (vec2(texel) + 0.5) / vec2(size);
    vec3 lit = textureLod(litImage, uv, 0.0).rgb;

    vec4 posSample = textureLod(inPosition, uv, 0.0);

    bool showOnly = pc.params2.z > 0.5;

    // sky, disabled, or nothing to reflect: pass the lit colour straight through
    if (pc.params.x < 0.5 || posSample.w < 0.5)
    {
        imageStore(outImage, texel, vec4(showOnly ? vec3(0.0) : lit, 1.0));
        return;
    }

    vec2 mr = textureLod(inMetalRough, uv, 0.0).xy;
    float metallic = mr.x;
    float roughness = mr.y;

    // Rough surfaces scatter too widely for a single mirror ray to mean anything, and skipping them
    // early is what keeps this affordable: most of the scene is rough.
    float maxRoughness = pc.params.y;
    if (roughness > maxRoughness)
    {
        imageStore(outImage, texel, vec4(showOnly ? vec3(0.0) : lit, 1.0));
        return;
    }

    vec3 P = posSample.xyz;
    vec3 N = normalize(textureLod(inNormal, uv, 0.0).xyz);
    vec3 V = normalize(P - sceneData.cameraPos.xyz);
    vec3 R = reflect(V, N);

    int steps = int(pc.params.z);
    float maxDistance = pc.params2.x;
    float stepLength = maxDistance / float(steps);
    float thickness = pc.params.w;

    // offset along the normal so the first step cannot re-intersect the originating surface
    vec3 rayPos = P + N * thickness;
    vec3 hitColor = vec3(0.0);
    float hitMask = 0.0;
    vec2 hitUV = vec2(-1.0); // sentinel: a refine that never brackets the hit must not sample (0,0)

    for (int i = 0; i < steps; i++)
    {
        rayPos += R * stepLength;

        vec2 sampleUV;
        float clipW;
        if (!project(rayPos, sampleUV, clipW))
        {
            break;
        }
        if (any(lessThan(sampleUV, vec2(0.0))) || any(greaterThan(sampleUV, vec2(1.0))))
        {
            break; // left the screen; there is no information out there
        }

        vec4 sceneSample = textureLod(inPosition, sampleUV, 0.0);
        if (sceneSample.w < 0.5)
        {
            continue; // sky
        }

        float rayDepth = length(rayPos - sceneData.cameraPos.xyz);
        float sceneDepth = length(sceneSample.xyz - sceneData.cameraPos.xyz);

        // The ray has passed behind a surface. The thickness test rejects hits where the surface is
        // far in front, which would otherwise reflect geometry the ray never actually reached.
        if (rayDepth > sceneDepth && rayDepth - sceneDepth < thickness + stepLength)
        {
            // binary refine between the last two positions for a sharper contact
            vec3 lo = rayPos - R * stepLength;
            vec3 hi = rayPos;
            for (int j = 0; j < 4; j++)
            {
                vec3 mid = (lo + hi) * 0.5;
                vec2 midUV;
                float midW;
                if (!project(mid, midUV, midW))
                {
                    break;
                }
                vec4 midScene = textureLod(inPosition, midUV, 0.0);
                float midRay = length(mid - sceneData.cameraPos.xyz);
                float midDepth = length(midScene.xyz - sceneData.cameraPos.xyz);

                if (midRay > midDepth)
                {
                    hi = mid;
                    hitUV = midUV;
                }
                else
                {
                    lo = mid;
                }
            }

            if (hitUV.x < 0.0)
            {
                break; // refine never bracketed the surface; treat as a miss
            }

            hitColor = textureLod(litImage, hitUV, 0.0).rgb;
            hitMask = 1.0;
            break;
        }
    }

    if (hitMask > 0.0)
    {
        // Fade toward the screen edges. Without this, reflections terminate in a hard line wherever
        // the reflected geometry leaves the frame, which is SSR's most obvious tell.
        vec2 edge = smoothstep(vec2(0.0), vec2(0.15), hitUV) * smoothstep(vec2(0.0), vec2(0.15), 1.0 - hitUV);
        hitMask *= edge.x * edge.y;

        // rays pointing back at the camera reflect information we do not have
        hitMask *= clamp(1.0 - max(dot(R, -V), 0.0), 0.0, 1.0);

        // Fade across the whole range up to the cutoff, not just the top half: a single mirror ray
        // on a semi-rough surface produces hit/miss blotching rather than a believable reflection.
        hitMask *= 1.0 - smoothstep(0.0, maxRoughness, roughness);
    }

    vec3 F0 = mix(vec3(0.04), lit, metallic);
    vec3 fresnel = fresnelSchlick(max(dot(N, -V), 0.0), F0);

    vec3 reflection = hitColor * fresnel * hitMask * pc.params2.y;
    imageStore(outImage, texel, vec4(showOnly ? reflection : lit + reflection, 1.0));
}
