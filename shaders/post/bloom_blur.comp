#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D srcImage;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D outImage;

layout(push_constant) uniform BloomPush
{
    vec4 params; // xy = blur direction in texels, z = radius scale
}
pc;

// 9-tap gaussian folded into 5 bilinear taps: the hardware filter gives two samples per fetch.
const float OFFSETS[3] = float[3](0.0, 1.3846153846, 3.2307692308);
const float WEIGHTS[3] = float[3](0.2270270270, 0.3162162162, 0.0702702703);

void main()
{
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outImage);
    if (texel.x >= size.x || texel.y >= size.y)
    {
        return;
    }

    vec2 texelSize = 1.0 / vec2(size);
    vec2 uv = (vec2(texel) + 0.5) * texelSize;
    vec2 dir = pc.params.xy * texelSize * pc.params.z;

    vec3 result = textureLod(srcImage, uv, 0.0).rgb * WEIGHTS[0];
    for (int i = 1; i < 3; i++)
    {
        result += textureLod(srcImage, uv + dir * OFFSETS[i], 0.0).rgb * WEIGHTS[i];
        result += textureLod(srcImage, uv - dir * OFFSETS[i], 0.0).rgb * WEIGHTS[i];
    }

    imageStore(outImage, texel, vec4(result, 1.0));
}
