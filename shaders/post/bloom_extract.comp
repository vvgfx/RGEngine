#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D hdrImage;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D outImage;

layout(push_constant) uniform BloomPush
{
    vec4 params; // x = threshold
}
pc;

void main()
{
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outImage);
    if (texel.x >= size.x || texel.y >= size.y)
    {
        return;
    }

    // half-res target, so this bilinear tap averages a 2x2 block of the source
    vec2 uv = (vec2(texel) + 0.5) / vec2(size);
    vec3 color = textureLod(hdrImage, uv, 0.0).rgb;

    // Keep only the excess over the threshold. Passing the *whole* colour through meant an emissive
    // bulb at 40 contributed 40 to its neighbours, so intensity had to be ~0.03 to look sane.
    imageStore(outImage, texel, vec4(max(color - pc.params.x, 0.0), 1.0));
}
